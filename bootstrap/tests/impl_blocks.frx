mod test;

struct Foo
{
    x: i32;
    bar: Bar;
}

impl Foo
{
    fn new(x: i32) -> Self
    {
        let foo = Self
        {
            x: x;
            bar: Bar::new(42);
        };

        return foo;
    }

    fn get_value(self*) -> i32
    {
        return self.x;
    }

    fn get_bar(self*) -> Bar*
    {
        return &self.bar;
    }
}

struct Bar
{
    y: i32;
}

impl Bar
{
    fn new(y: i32) -> Self
    {
        let bar = Self
        {
            y: y;
        };

        return bar;
    }

    fn get_value(self*) -> i32
    {
        return self.y;
    }
}

fn main() -> i32
{
    let foo = Foo::new(42);

    return foo.get_value() - foo.get_bar().get_value();
}
