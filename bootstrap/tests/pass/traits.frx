mod test;

trait Sizeable
{
    fn size(ptr: void*) -> usize;
}

struct Foo
{
    x: usize;
}

impl Foo
{
    pub fn new(x: usize) -> Foo
    {
        let foo: Foo;
        foo.x = x;
        return foo;
    }
}

impl Sizeable for Foo
{
    fn size(foo: Foo*) -> usize
    {
        return foo.x;
    }
}

fn main() -> i32
{
    let foo = Foo::new(0);
    return foo.size();
}
